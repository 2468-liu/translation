# Auto detect text files and perform LF normalization on checkin
* text=auto

# Explicitly lock all shell scripts to LF line endings on all OS platforms
*.sh text eol=lf
*.bash text eol=lf
*.zsh text eol=lf

# Ensure Python, JSON, YAML, and Markdown files use LF
*.py text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf

# Windows batch and powershell scripts can retain CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.ico binary
*.wav binary
*.bin binary
*.gguf binary
*.onnx binary
*.zip binary
*.exe binary
*.dll binary
*.pyd binary
